{
  "hooks": {
    "UserPromptSubmit": [
      {
        "condition": "input.startsWith('/brandifai:help') || input.includes('<command-name>/brandifai:help</command-name>')",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.claude/commands/brandifai/help-handler.py"
          }
        ]
      },
      {
        "condition": "input.startsWith('/brandifai:task ') || input.includes('<command-name>/brandifai:task</command-name>')",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.claude/commands/brandifai/task-handler.py"
          }
        ]
      },
      {
        "condition": "input.startsWith('/brandifai:task-plan ') || input.includes('<command-name>/brandifai:task-plan</command-name>')",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.claude/commands/brandifai/task-plan-handler.py"
          }
        ]
      },
      {
        "condition": "input.startsWith('/brandifai:task-exec ') || input.includes('<command-name>/brandifai:task-exec</command-name>')",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.claude/commands/brandifai/task-exec-handler.py"
          }
        ]
      }
    ]
  }
}
